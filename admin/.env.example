# PandaVip — Admin (Vite). Copie para .env e preencha com o SEU projeto Firebase.
# Pegue em: Firebase Console > Configurações do projeto > Seus apps > Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise). NÃO é segredo: o ID da chave é público e o
# Google o valida contra o domínio de origem. Crie a chave em Google Cloud
# Console > Segurança > reCAPTCHA Enterprise (tipo Site), depois registre em
# Firebase Console > App Check > app Web. O reCAPTCHA v3 clássico foi
# descontinuado pelo Google.
#
# Vazia, o painel roda sem App Check (comportamento atual). Preencha ANTES de
# impor o App Check no console — sem ela, impor derruba o painel do dono.
VITE_RECAPTCHA_SITE_KEY=

# Opcional: modo demo (bypassa auth como admin + dados fake, sem backend).
# Use pra demonstrar a UI sem projeto Firebase. Deixe vazio/false em produção.
VITE_DEMO=false
