<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Acesso à rede. Só o manifesto de debug declarava; em release o app
         depende de um plugin declarar por tabela, o que não é garantido. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+: sem isso o sistema nunca mostra o pedido de permissão e
         nenhum aviso do painel chega no aparelho. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- ID de publicidade: entra por tabela com o firebase_analytics. O app não
         tem anúncio nem atribuição de campanha, então coletar isso seria dado
         pessoal sem finalidade (LGPD art. 6º, III). Se um dia voltar, a
         declaração "ID de publicidade" no Play Console tem que mudar junto. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove"/>

    <!-- android:allowBackup="false" — backup automático desligado. Ligado (o
         padrão do Android) o sistema copia o diretório de dados do app,
         incluindo o SharedPreferences onde mora a fila de chamadas pendentes
         (core/services/fila_pendentes.dart), pro Google Drive do dono do
         aparelho; e o `adb backup` extrai o mesmo conteúdo por cabo, sem root.
         Nada aqui precisa sobreviver à troca de celular: a fila é rascunho
         local e todo o resto volta do Firestore depois do login.

         android:usesCleartextTraffic="false" — recusa HTTP puro em qualquer
         biblioteca do processo. Já é o padrão no targetSdk atual, mas
         declarado ele não volta atrás sozinho num salto de SDK. -->
    <application
        android:label="PandaVip"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/regras_extracao"
        android:usesCleartextTraffic="false">
        <!-- android:filterTouchesWhenObscured="true" — tapjacking: descarta o
             toque que chegar com outra janela por cima. É o que impede um app
             malicioso de sobrepor uma tela transparente e colher o toque em
             "Cancelar assinatura" ou no botão que confirma um resgate. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:filterTouchesWhenObscured="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:enableOnBackInvokedCallback="false"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Toque no aviso do FCM abre o app pela rota padrão. -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- Canal criado em MainActivity.kt. Os dois têm que continuar com o
             mesmo id: apontar para um canal inexistente faz o Android
             DESCARTAR a notificação em silêncio. -->
        <!-- Analytics sem ID de publicidade e sem sinais de anúncio. -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="pandavip_avisos" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Android 11+ esconde os outros apps: sem declarar o que a gente
             pretende abrir, `canLaunchUrl` devolve false e os botões Ligar,
             WhatsApp, Como chegar e Atualizar agora não fazem nada. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>
