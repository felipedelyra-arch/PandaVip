<?xml version="1.0" encoding="utf-8"?>
<!-- Mesmo laranja no modo escuro. Sem este arquivo, o aparelho em modo escuro
     cairia no values-night e a splash voltaria a ser preta. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/panda_laranja</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/panda_laranja</item>
    </style>
</resources>
