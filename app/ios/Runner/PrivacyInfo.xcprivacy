<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Manifesto de privacidade exigido pela App Store. Tem que bater com a
     política (app/web/privacidade.html) e com o "Privacidade do app" no App
     Store Connect. Os plugins trazem os manifestos deles; este cobre o app. -->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
