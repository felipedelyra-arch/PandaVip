# PandaVip — Cloud Functions env
#
# ⚠️ SEGREDO DE VERDADE NÃO MORA MAIS AQUI.
#
# Segredo que vale dinheiro mora no Google Secret Manager (ver
# `src/lib/segredos.ts`). O motivo: o `.env` não vai pro git, mas VAI junto no
# deploy — vira configuração legível da função, e qualquer conta com papel de
# leitura no projeto lê o valor vivo.
#
# Preencha cada um uma vez, com:
#
#   firebase functions:secrets:set PDV_WEBHOOK_SECRET
#
# O comando lê o valor da entrada padrão — não fica no histórico do shell.
# Trocar depois: rode de novo (cria versão nova) e faça deploy.
#
# Copie este arquivo para `.env` só para o EMULADOR: rodando local,
# `.value()` cai de volta no process.env. Nunca ponha valor de produção aqui.
#
# O gateway de pagamento (Mercado Pago) ainda não está integrado. Os segredos
# dele entram aqui e em `segredos.ts` junto com a integração — ver
# PAGAMENTOS.md. Declarar antes trava o deploy de todas as functions.

# --- PDV do salão (consumo em mesa/comanda) — só emulador ---
# Segredo compartilhado com quem envia a conta fechada. O corpo cru do POST vai
# assinado em HMAC-SHA256 no header x-pdv-signature.
PDV_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxx

# --- Configuração (não é segredo, pode ficar no .env) ---
APP_NAME=PandaVip
SUPPORT_EMAIL=contato@exemplo.com.br

# --- App Check ---
# `true` recusa toda chamada que não trouxer token de App Check válido.
# Só ligue DEPOIS de: (1) criar a chave de site do reCAPTCHA e ativar o App
# Check no painel e no build web do app, e (2) impor no console do Firebase.
# Ligar antes disso derruba o painel do dono. Ver functions/src/lib/guards.ts.
REQUER_APP_CHECK=false

# Caixa que recebe os e-mails do Mercado Pago (o cliente não recebe nada).
# O app manda <local>+<uid>@<dominio> como pagador — use Gmail/Workspace.
MP_EMAIL_PAGADOR=dono@exemplo.com
